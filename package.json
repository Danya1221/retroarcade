{
  "name": "retroarcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "build": "npm run check",
    "migrate": "node --env-file-if-exists=.env database/migrate.js",
    "bot:setup": "node --env-file-if-exists=.env scripts/setup-bot.js"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "1.55.1",
    "prettier": "^3.6.2"
  }
}
